# ── Sleeper API Configuration ──────────────────────────────────────────────
# Your Sleeper username (used to resolve your user ID and leagues)
SLEEPER_USERNAME=your_sleeper_username

# Your league ID (found in the URL when viewing your league on sleeper.com)
# Example: https://sleeper.com/leagues/1234567890123456789 → ID is 1234567890123456789
SLEEPER_LEAGUE_ID=your_league_id_here

# NFL season year
NFL_SEASON=2026

# Scoring type: ppr, half, or standard
SCORING_TYPE=ppr

# ── Pipeline Settings ─────────────────────────────────────────────────────
# Set to "true" to use demo data (no live API calls)
# Set to "false" to use live Sleeper API data
DEMO_MODE=true

# Set to "true" to sanitize output for public display (hides real names)
SANITIZE_OUTPUT=true
