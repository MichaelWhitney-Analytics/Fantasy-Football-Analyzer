// FF_PLAYER_METADATA_PATCH_V1
// Resolve live roster IDs using Sleeper's NFL player directory.
(function installPlayerMetadataPatch() {
  let playersById = null;
  let playersRequest = null;

  const originalDashboardApiFetch = dashboardApiFetch;
  const originalBuildPlaceholderPlayer = buildPlaceholderPlayer;

  async function loadPlayerDirectory() {
    if (playersById) {
      return playersById;
    }

    if (!playersRequest) {
      playersRequest = sleeperFetchJson(
        "/players/nfl",
        "Unable to load Sleeper player names and positions. Please retry."
      )
        .then(data => {
          if (
            !data ||
            typeof data !== "object" ||
            Array.isArray(data) ||
            Object.keys(data).length === 0
          ) {
            throw new Error("Sleeper returned an invalid player directory.");
          }

          playersById = data;
          return data;
        })
        .catch(error => {
          playersRequest = null;
          throw error;
        });
    }

    return playersRequest;
  }

  dashboardApiFetch = async function(path, fallbackMessage) {
    if (!path.startsWith("/api/dashboard")) {
      return originalDashboardApiFetch(path, fallbackMessage);
    }

    const [payload] = await Promise.all([
      originalDashboardApiFetch(path, fallbackMessage),
      loadPlayerDirectory()
    ]);

    return payload;
  };

  buildPlaceholderPlayer = function(playerId, isStarter) {
    const id = String(playerId);
    const metadata = playersById?.[id];
    const result = originalBuildPlaceholderPlayer(playerId, isStarter);

    // Missing projections remain unavailable, not invented zero estimates.
    result.projected_points = null;
    result.season_points = null;
    result.recent_avg = null;

    if (!metadata) {
      result.name = `Unresolved player (${id})`;
      result.team = "--";
      result.position = "UNKNOWN";
      result.trend_label = "Player metadata unavailable";

      console.warn("No Sleeper metadata found for roster player:", id);
      return result;
    }

    const joinedName = [
      metadata.first_name,
      metadata.last_name
    ].filter(Boolean).join(" ").trim();

    const isDefense =
      metadata.position === "DEF" ||
      metadata.fantasy_positions?.includes("DEF");

    result.name =
      metadata.full_name ||
      joinedName ||
      (isDefense ? `${metadata.team || id} D/ST` : `Unresolved player (${id})`);

    result.team = metadata.team || "FA";
    result.position =
      metadata.position ||
      metadata.fantasy_positions?.[0] ||
      "UNKNOWN";

    result.injury_status = metadata.injury_status || "";
    result.bye_week = metadata.bye_week ?? "";
    result.trend_label = "Live roster";

    return result;
  };
})();

// FF_TRENDING_ADDS_PATCH_V1
(function installTrendingAddsPatch() {
  const originalLoad = loadLiveSleeperDashboard;
  let playerDirectoryRequest = null;
  let loadSequence = 0;

  function getPlayerDirectory() {
    if (!playerDirectoryRequest) {
      playerDirectoryRequest = sleeperFetchJson(
        "/players/nfl",
        "Unable to retrieve player metadata for trending activity."
      ).catch(error => {
        playerDirectoryRequest = null;
        throw error;
      });
    }
    return playerDirectoryRequest;
  }

  loadLiveSleeperDashboard = async function() {
    const sequence = ++loadSequence;

    await originalLoad();

    const pageData = dashboardData;
    const container = getElement("trendingActivity");

    if (container) {
      container.textContent = "Loading live trending-add activity...";
    }

    try {
      const [adds, directory] = await Promise.all([
        sleeperFetchJson(
          "/players/nfl/trending/add?lookback_hours=24&limit=25",
          "Unable to retrieve Sleeper trending adds."
        ),
        getPlayerDirectory()
      ]);

      if (!Array.isArray(adds)) {
        throw new Error("Sleeper returned invalid trending-add data.");
      }

      if (sequence !== loadSequence || dashboardData !== pageData) {
        return;
      }

      const rosteredIds = new Set(
        sleeperState.rosters.flatMap(roster =>
          (roster.players || []).map(String)
        )
      );

      const enrichedAdds = adds.map(item => {
        const id = String(item.player_id);
        const player = directory[id] || {};
        const joinedName = [
          player.first_name,
          player.last_name
        ].filter(Boolean).join(" ");

        const name =
          player.full_name ||
          joinedName ||
          (player.position === "DEF"
            ? `${player.team || id} D/ST`
            : `Unresolved player (${id})`);

        return {
          player_id: id,
          name,
          position: player.position || "UNKNOWN",
          team: player.team || "FA",
          count: item.count,
          available_in_league: !rosteredIds.has(id)
        };
      });

      pageData.analysis.player_trends.trending_adds = enrichedAdds;

      renderTrends(pageData.analysis.player_trends);

      if (container) {
        const title = container.querySelector(".trending-list-title");
        if (title) {
          title.textContent = "Sleeper trending adds - last 24 hours";
        }

        container.querySelectorAll(".trending-item").forEach((row, index) => {
          const item = enrichedAdds[index];
          if (!item) return;

          const availability = document.createElement("div");
          availability.textContent = item.available_in_league
            ? "Unrostered in your selected league"
            : "Already rostered in your selected league";
          availability.style.fontSize = "12px";
